{
  "name": "@it-bens-ai/clipboard-agent-tools",
  "version": "2.0.0",
  "description": "Clipboard MCP tools for pi: copy inline text or a file's contents to the system clipboard, with a bash check that keeps the agent on the MCP tools.",
  "type": "module",
  "license": "MIT",
  "author": { "name": "Martin Bens", "email": "martin.bens@it-bens.de" },
  "homepage": "https://github.com/it-bens-ai/clipboard-agent-tools/tree/main/plugins/clipboard-copy",
  "repository": { "type": "git", "url": "git+https://github.com/it-bens-ai/clipboard-agent-tools.git" },
  "bugs": "https://github.com/it-bens-ai/clipboard-agent-tools/issues",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./plugins/clipboard-copy/pi/index.ts"],
    "image": "https://raw.githubusercontent.com/it-bens-ai/clipboard-agent-tools/main/.github/assets/social-preview.png"
  },
  "files": [
    "plugins/clipboard-copy/pi/",
    "plugins/clipboard-copy/hooks/scripts/",
    "plugins/clipboard-copy/hooks/prompts/",
    "plugins/clipboard-copy/mcp-server-clipboard/",
    "plugins/clipboard-copy/shared/",
    "plugins/clipboard-copy/README.md",
    "plugins/clipboard-copy/CHANGELOG.md",
    "!**/*.log"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"plugin-tests/clipboard-copy/pi/*.test.ts\""
  },
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
