{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "plugins/clipboard-copy/pi/**/*.ts",
    "plugin-tests/clipboard-copy/pi/**/*.ts",
    "plugin-tests/clipboard-copy/fixtures/pi/**/*.ts"
  ]
}
